# Supabase Configuration
# The API URL of your Supabase project (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The Anon/Public Key of your Supabase project (found in Project Settings -> API)
# Safe to expose in browser bundle for public SELECT requests
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# The Service Role Key (found in Project Settings -> API)
# WARNING: Keep secret, never expose to browser. Used for server-side RLS bypass writes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Secret / Database Password
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Admin Password
# A secure password of your choice used to log in to the /admin dashboard
ADMIN_PASSWORD=your-custom-admin-password
